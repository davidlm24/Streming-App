# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=

# Supabase. The URL and publishable key are the only Supabase values allowed in
# browser code. Keep the server secret in the host's secret store and never
# prefix it with VITE_. The server validates every sign-in and reads profiles
# with SUPABASE_URL and SUPABASE_SECRET_KEY; without them, nobody signs in.
# Locally, `npx supabase status -o env` prints the local stack's values (public
# development defaults): API_URL goes in VITE_SUPABASE_URL and SUPABASE_URL,
# PUBLISHABLE_KEY in VITE_SUPABASE_PUBLISHABLE_KEY, SECRET_KEY in
# SUPABASE_SECRET_KEY.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Stripe (checkout, billing portal and webhook)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_PRO=
STRIPE_PRICE_BUSINESS=

# Cloudflare Stream API Credentials
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_CUSTOMER_SUBDOMAIN=

# Streaming Engine / Media Server (SRS / RTMP / WHIP)
MEDIA_SERVER_URL=
MEDIA_SERVER_RTMP_INGEST=
MEDIA_SERVER_SECRET=

# Multi-Platform OAuth & Live Streaming Integrations
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Role-Based Access Control (RBAC)
# E-mails de admin, separados por vírgula. Só valem com e-mail confirmado. O
# servidor mantém o papel em public.user_roles igual a esta lista, e é esse
# papel que a RLS do banco consulta. Mudar a lista pede subir o servidor de
# novo (na Vercel, um novo deploy): ao subir, ele acerta o papel de todas as
# contas.
SUPER_ADMIN_EMAILS=
