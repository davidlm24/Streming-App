# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="sua-chave-do-gemini"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Cloudflare Stream API Credentials
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_CUSTOMER_SUBDOMAIN=

# Streaming Engine / Media Server (SRS / RTMP / WHIP)
MEDIA_SERVER_URL=
MEDIA_SERVER_RTMP_INGEST=
MEDIA_SERVER_SECRET=

# Multi-Platform OAuth & Live Streaming Integrations
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Role-Based Access Control (RBAC)
SUPER_ADMIN_EMAILS="mgdlms@gmail.com"

