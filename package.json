{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "dev": "tsx start-server.ts",
    "build": "vite build && esbuild start-server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:contrast": "node scripts/contrast-gate.mjs",
    "lint:debt": "node scripts/design-debt.mjs",
    "debt:update": "node scripts/design-debt.mjs --update",
    "ds:build": "node design-system/build-tokens.mjs && node design-system/gen-components.mjs",
    "ds:check": "node design-system/build-tokens.mjs --check",
    "verify": "npm run lint && npm run test:cliente && npm run lint:css && npm run lint:contrast && npm run lint:debt && npm run lint:icons && npm run lint:labels && npm run lint:csp",
    "lint:icons": "node scripts/icon-buttons.cjs",
    "lint:labels": "node scripts/form-labels.cjs",
    "lint:csp": "tsx scripts/csp-vercel.ts",
    "db:start": "supabase start -x studio,imgproxy,edge-runtime,logflare,vector,supavisor",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:contas": "node scripts/contas-de-teste.mjs",
    "test:cliente": "tsx --test tests/cliente/*.test.ts",
    "test:servidor": "tsx --test tests/servidor/servidor.test.ts",
    "motor:dev": "tsx motor/motor.ts",
    "motor:build": "esbuild motor/motor.ts --bundle --platform=node --target=node22 --format=cjs --outfile=motor/dist/motor.cjs",
    "test:motor": "tsx --test tests/motor/*.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "2.117.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.22.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "stripe": "^22.5.0",
    "uqr": "^0.1.3",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/pg": "^8.20.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.25.0",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "supabase": "^2.118.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "overrides": {
    "@google-cloud/storage": "8.0.1",
    "uuid": "11.1.1",
    "esbuild": "$esbuild"
  }
}
